# Copia a infra/.env para sobrescribir las credenciales de desarrollo. Nunca subas infra/.env.
POSTGRES_PASSWORD=postgres-dev-password
REPLICATION_PASSWORD=replicator-dev-password
# Vacío = replicación asíncrona (si trabajas sin la réplica, las escrituras no se bloquean).
PG_SYNC_STANDBY_NAMES=ANY 1 (replica1)
# Contraseña de cada base de servicio: PG_PASSWORD_<SERVICIO>. Por defecto: <servicio>-dev-password.
# PG_PASSWORD_IDENTITY=
REDIS_PASSWORD=redis-dev-password
RABBITMQ_USER=ticketera
RABBITMQ_PASSWORD=rabbitmq-dev-password
# identity: 32 bytes en base64 que cifran las claves privadas de firma (cámbialo fuera de desarrollo).
IDENTITY_KEY_ENCRYPTION_SECRET=ZGV2LW9ubHkta2V5LWVuY3J5cHRpb24tc2VjcmV0ISE=
PUBLIC_WEB_URL=https://localhost:8443
BOOTSTRAP_ADMIN_EMAIL=admin@ticketera.local
BOOTSTRAP_ADMIN_PASSWORD=admin-dev-password-123
CORS_ORIGINS=https://localhost:8443
# catalog: carga los datos de demostración del prototipo si el catálogo está vacío.
CATALOG_SEED_DEMO_DATA=true
