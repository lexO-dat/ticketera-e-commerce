# Web (TanStack Start). Copia a .env (nunca subas .env).
# API Gateway que usan las server functions (BFF, ADR-08).
GATEWAY_URL=http://127.0.0.1:3000
# Cookies de sesión con Secure (déjalo en true; los navegadores aceptan Secure en http://localhost).
COOKIE_SECURE=true
# Transitorio: datos que aún viven en Supabase hasta migrar catálogo, inventario y órdenes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
