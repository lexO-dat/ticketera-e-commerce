{
  "name": "ticketera",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w @apps/web",
    "build": "npm run build -w @apps/web",
    "lint": "eslint .",
    "lint:backend": "eslint --no-error-on-unmatched-pattern packages services tools scripts",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:backend": "npm run build --workspaces --if-present",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "new:service": "node scripts/new-service.mjs",
    "simulate:queue": "npm run simulate -w @tools/queue-simulator --",
    "test:failover": "npm run failover -w @tools/failover-test --",
    "infra:pg-rejoin": "node scripts/pg-rejoin.mjs",
    "dev:scanner": "npm run dev -w @apps/scanner"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "tools/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  }
}
