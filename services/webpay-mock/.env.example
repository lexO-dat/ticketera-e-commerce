# Copia a .env para `npm run dev` (nunca subas .env). Valores de infra/docker-compose.yml.
SERVICE_NAME=webpay-mock
PORT=3005
LOG_LEVEL=debug
REDIS_URL=redis://:redis-dev-password@127.0.0.1:6379
# Credenciales del API simulado (solo desarrollo).
WEBPAY_API_KEY_ID=597055555532
WEBPAY_API_KEY_SECRET=webpay-mock-dev-secret-0123456789
WEBPAY_FORM_URL=https://localhost:8443/webpay/form
WEBPAY_MOCK_DEFAULT_OUTCOME=reject
WEBPAY_MOCK_LATENCY_MS=0
WEBPAY_MOCK_COMMIT_LOSS_RATIO=0
WEBPAY_MOCK_ERROR_RATIO=0
