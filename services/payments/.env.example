# Copia a .env para `npm run dev` (nunca subas .env). Valores de infra/docker-compose.yml.
SERVICE_NAME=payments
PORT=3006
LOG_LEVEL=debug
DATABASE_URL=postgres://payments:payments-dev-password@127.0.0.1:5432/payments
REDIS_URL=redis://:redis-dev-password@127.0.0.1:6379
AMQP_URL=amqp://ticketera:rabbitmq-dev-password@127.0.0.1:5672
JWKS_URL=http://127.0.0.1:3000/.well-known/jwks.json
# Solo desarrollo: secreto compartido de los endpoints /internal.
INTERNAL_API_TOKEN=internal-dev-token-change-me-0123456789
ORDERS_URL=http://127.0.0.1:3007
WEBPAY_URL=http://127.0.0.1:3005
WEBPAY_API_KEY_ID=597055555532
WEBPAY_API_KEY_SECRET=webpay-mock-dev-secret-0123456789
WEBPAY_SEND_MOCK_PAYER_EMAIL=true
PAYMENT_RETURN_URL=https://localhost:8443/api/payments/return
PUBLIC_WEB_URL=https://localhost:8443
