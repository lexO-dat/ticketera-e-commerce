# Copia a .env (nunca subas .env). Valores de infra/docker-compose.yml para correr fuera de Docker:
#   uv run --env-file .env python -m notifications.main
SERVICE_NAME=notifications
PORT=3009
LOG_LEVEL=debug
AMQP_URL=amqp://ticketera:rabbitmq-dev-password@127.0.0.1:5672
REDIS_URL=redis://:redis-dev-password@127.0.0.1:6379
TICKETS_URL=http://127.0.0.1:3008
INTERNAL_API_TOKEN=internal-dev-token-change-me-0123456789
PUBLIC_WEB_URL=https://localhost:8443

# SMTP. En desarrollo, Mailpit (bandeja en http://localhost:8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Ticketera <no-responder@ticketera.local>
MAIL_REPLY_TO=

# Producción: basta con la API key del proveedor como contraseña SMTP. Ejemplo (SendGrid):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=<tu API key>
# MAIL_FROM=Ticketera <no-responder@tu-dominio-verificado.cl>
