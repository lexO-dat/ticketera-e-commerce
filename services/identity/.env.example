# Copia a .env para `npm run dev` (nunca subas .env). Valores de infra/docker-compose.yml.
SERVICE_NAME=identity
PORT=3001
LOG_LEVEL=debug
DATABASE_URL=postgres://identity:identity-dev-password@127.0.0.1:5432/identity
AMQP_URL=amqp://ticketera:rabbitmq-dev-password@127.0.0.1:5672
# 32 bytes en base64 (solo desarrollo). Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_SECRET=ZGV2LW9ubHkta2V5LWVuY3J5cHRpb24tc2VjcmV0ISE=
PUBLIC_WEB_URL=https://localhost:8443
BOOTSTRAP_ADMIN_EMAIL=admin@ticketera.local
BOOTSTRAP_ADMIN_PASSWORD=admin-dev-password-123
